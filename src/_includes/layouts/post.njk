---
layout: layouts/base.njk
---
<div class="max-w-[1240px] mx-auto px-6 md:px-8 py-10 md:py-16 flex-grow">
  <!-- Back button -->
  <div class="mb-8">
    <a href="/blog/" class="inline-flex items-center gap-2 rounded-full bg-[#111827]/80 border border-white/[0.08] hover:bg-white/5 px-4 py-2 text-xs font-semibold text-[#94A3B8] hover:text-[#F8FAFC] transition-all duration-200 relative z-10">
      <span class="material-symbols-outlined text-[16px]">arrow_back</span>
      <span>Back to Blog</span>
    </a>
  </div>

  <article class="relative overflow-hidden rounded-2xl bg-[#111827]/70 border border-white/[0.08] backdrop-blur-md p-8 md:p-12 shadow-2xl">
    <!-- Ambient post light -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#8B5CF6]/10 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse"></div>

    <header class="border-b border-white/[0.08] pb-8 mb-8">
      <time class="text-xs font-mono font-medium text-[#94A3B8] tracking-wider uppercase block mb-3">
        {{ date | postDate }}
      </time>
      <h1 class="text-3xl font-bold text-[#F8FAFC] tracking-tight sm:text-4xl md:text-5xl font-headline">
        {{ title }}
      </h1>
      
      <!-- Tags list -->
      <div class="mt-6 flex flex-wrap gap-2">
        {% for tag in tags %}
          {% if tag != "posts" %}
          <span class="inline-flex items-center rounded-full bg-white/5 border border-white/[0.08] px-3 py-1 text-[11px] font-semibold text-[#94A3B8]">
            {{ tag }}
          </span>
          {% endif %}
        {% endfor %}
      </div>
    </header>

    <!-- Post Content -->
    <div class="blog-content prose prose-invert max-w-none text-[#94A3B8] leading-relaxed">
      {{ content | safe }}
    </div>
  </article>
</div>
