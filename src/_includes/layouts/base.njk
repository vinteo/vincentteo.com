<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Vin's Space — Vincent Teo Portfolio") }}</title>
  <meta name="description" content="{{ description | default("Personal portfolio and project showcase of Vincent Teo.") }}">
  
  <!-- Material Symbols Outlined -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap">

  <!-- Google Fonts: Outfit, Geist, Space Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  
  <!-- CSS -->
  <link rel="stylesheet" href="/assets/css/main.css?v={{ build.timestamp }}">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/images/favicon.png">
  
  <!-- JS -->
  <script src="/assets/js/main.js" defer></script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-33JTHN62YS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-33JTHN62YS');
  </script>
</head>
<body class="bg-[#0B0F17] text-[#F8FAFC] min-h-screen relative font-sans antialiased overflow-x-hidden flex flex-col selection:bg-[#8B5CF6]/30 selection:text-[#F8FAFC]">

  <!-- Subtle Ambient Atmospheric Glow Layers -->
  <div class="fixed inset-0 pointer-events-none ambient-glow-purple z-0"></div>
  <div class="fixed inset-0 pointer-events-none ambient-glow-pink z-0"></div>
  <div class="fixed inset-0 pointer-events-none ambient-glow-cyan z-0"></div>

  <!-- Header -->
  <header class="sticky top-0 z-50 w-full bg-[#0B0F17]/80 backdrop-blur-xl border-b border-white/[0.08] shadow-lg shadow-[#0a0e16]/50 transition-all duration-300">
    <div class="max-w-[1240px] mx-auto px-6 md:px-8 flex items-center justify-between h-16">
      <!-- Brand Logo -->
      <a href="/" class="text-base font-bold text-[#F8FAFC] flex items-center gap-3 group">
        <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#a078ff] to-[#EC4899] p-[1.5px] transition-transform duration-200 group-hover:scale-105">
          <img src="/assets/images/profile.jpg" alt="Vincent Teo avatar" class="w-full h-full object-cover rounded-full">
          <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-[#A3E635] rounded-full border-2 border-[#0B0F17]"></span>
        </div>
        <span class="tracking-tight text-[#F8FAFC] font-bold text-lg font-headline">Vin's Space</span>
      </a>
      
      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8">
        <a href="https://3dmodel.tools/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs md:text-sm font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC] group">
          <img src="/assets/images/3dmodel-tools-logo.png" alt="3D Models" width="18" height="18" style="width: 18px; height: 18px; max-width: 18px; max-height: 18px;" class="nav-3dmodel-logo w-[18px] h-[18px] shrink-0 rounded object-contain transition-transform duration-200 group-hover:scale-105">
          <span>3D Models</span>
        </a>
        <a href="/blog/" class="nav-reset-link text-xs md:text-sm font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC]">Blog</a>
        <a href="/travel/" class="nav-reset-link text-xs md:text-sm font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC]">Travel</a>
      </nav>
      
      <!-- Action & Mobile Menu Toggle -->
      <div class="flex items-center gap-3">
        <a href="/#about" class="px-4 md:px-5 py-1.5 rounded-full text-xs md:text-sm font-semibold text-[#F8FAFC] bg-gradient-to-r from-[#8B5CF6] to-[#EC4899] hover:opacity-95 hover:shadow-lg hover:shadow-[#EC4899]/25 transition-all duration-200 active:scale-95">
          Get in Touch
        </a>
        <button id="mobile-menu-btn" class="flex md:hidden items-center justify-center p-2 rounded-xl border border-white/[0.08] text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-white/5 focus:outline-none transition-all duration-200" aria-label="Toggle navigation menu">
          <span class="material-symbols-outlined text-[20px]" id="menu-icon">menu</span>
        </button>
      </div>
    </div>
    
    <!-- Mobile Menu Panel -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.08] bg-[#0B0F17]/95 backdrop-blur-xl px-6 py-4 space-y-3">
      <a href="https://3dmodel.tools/" target="_blank" rel="noopener noreferrer" class="mobile-nav-link flex items-center gap-2.5 text-sm font-medium text-[#94A3B8] hover:text-[#F8FAFC] transition-colors duration-200 py-1.5 group">
        <img src="/assets/images/3dmodel-tools-logo.png" alt="3D Models" width="20" height="20" style="width: 20px; height: 20px; max-width: 20px; max-height: 20px;" class="mobile-nav-3dmodel-logo w-5 h-5 shrink-0 rounded object-contain transition-transform duration-200 group-hover:scale-105">
        <span>3D Models</span>
      </a>
      <a href="/blog/" class="mobile-nav-link block text-sm font-medium text-[#94A3B8] hover:text-[#F8FAFC] transition-colors duration-200 py-1.5">Blog</a>
      <a href="/travel/" class="mobile-nav-link block text-sm font-medium text-[#94A3B8] hover:text-[#F8FAFC] transition-colors duration-200 py-1.5">Travel</a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="relative z-10 flex-grow">
    {{ content | safe }}
  </main>

  <!-- Footer -->
  <footer class="w-full bg-[#0B0F17] border-t border-white/[0.08] relative z-10">
    <div class="max-w-[1240px] mx-auto px-6 md:px-8 py-10 flex flex-col md:flex-row justify-between items-center gap-6">
      <!-- Copyright Information -->
      <div class="text-center md:text-left">
        <p class="text-sm text-[#94A3B8]">
          © 2026 Vincent Teo. All rights reserved. Built with 11ty and Tailwind CSS.
        </p>
        <p class="text-xs text-[#94A3B8]/60 mt-1">
          Site and content created with AI assistance.
        </p>
      </div>
      <!-- Footer Navigation Links -->
      <nav class="flex flex-wrap items-center justify-center gap-6">
        <a class="text-xs font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC] hover:underline" href="/blog/">
          Blog
        </a>
        <a class="text-xs font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC] hover:underline" href="https://github.com/vinteo" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <a class="text-xs font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC] hover:underline" href="https://instagram.com/vinteo" target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
        <a class="text-xs font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC] hover:underline" href="https://youtube.com/@vinteo81" target="_blank" rel="noopener noreferrer">
          YouTube
        </a>
        <a class="text-xs font-medium text-[#94A3B8] transition-colors duration-200 hover:text-[#F8FAFC] hover:underline" href="mailto:contact@vincentteo.com">
          Email
        </a>
      </nav>
    </div>
  </footer>
</body>
</html>
