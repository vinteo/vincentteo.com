---
layout: layouts/base.njk
title: Vin's Space — Vincent Teo Portfolio
description: Personal portfolio showcasing open-source automation systems, parametric 3D fabrication models, and experimental gaming architectures.
---

<!-- Main Content Canvas -->
<div class="max-w-[1240px] mx-auto px-6 md:px-8 py-8 md:py-16">

  <!-- Hero / Headline Header Section -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div>
      <h1 class="text-4xl md:text-[56px] md:leading-[64px] font-bold tracking-tight text-[#F8FAFC] font-headline">
        Projects Showcase
      </h1>
      <p class="text-base md:text-lg text-[#94A3B8] mt-2 max-w-2xl leading-relaxed">
        A collection of open-source automation systems, parametric 3D fabrication models, and experimental gaming architectures.
      </p>
    </div>

    <!-- Segmented Interactive Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 p-1.5 rounded-full bg-[#181c24]/80 backdrop-blur-md border border-white/[0.08] self-start md:self-auto">
      <button id="filter-btn-all" class="px-4 py-1.5 rounded-full text-xs font-semibold text-[#F8FAFC] bg-[#8B5CF6] shadow-sm transition-all duration-150 cursor-pointer">
        All Showcase
      </button>
      <button id="filter-btn-software" class="px-4 py-1.5 rounded-full text-xs font-medium text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-white/5 transition-all duration-150 cursor-pointer">
        Open Source
      </button>
      <button id="filter-btn-printing" class="px-4 py-1.5 rounded-full text-xs font-medium text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-white/5 transition-all duration-150 cursor-pointer">
        3D Printing
      </button>
      <button id="filter-btn-games" class="px-4 py-1.5 rounded-full text-xs font-medium text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-white/5 transition-all duration-150 cursor-pointer">
        Games
      </button>
    </div>
  </div>

  <!-- SECTION 1: Open Source Software -->
  <section id="software" class="project-section mb-16 relative scroll-mt-24" data-category="software">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/[0.08]">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-gradient-to-r from-[#EC4899] to-[#8B5CF6]"></span>
        <h2 class="text-2xl md:text-3xl font-bold text-[#EC4899] tracking-tight font-headline">
          Open Source Software
        </h2>
      </div>
      <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-[#1c2028] border border-white/[0.08] text-[#94A3B8]">
        {{ projects.software.length }} Projects
      </span>
    </div>

    <!-- Grid for Open Source Software (Top 2 Items) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      
      <!-- Project 1: Home Assistant OpenSprinkler -->
      {% set p1 = projects.software[0] %}
      <article class="group rounded-xl bg-[#111827]/70 backdrop-blur-md border border-white/[0.08] overflow-hidden card-hover-border flex flex-col justify-between">
        <div>
          <div class="relative w-full aspect-video overflow-hidden bg-[#181c24]">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="{{ p1.title }}" src="{{ p1.image }}"/>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold font-headline text-[#F8FAFC] group-hover:text-[#8B5CF6] transition-colors duration-200">
              <a href="{{ p1.github }}" target="_blank" rel="noopener noreferrer">
                {{ p1.title }}
              </a>
            </h3>
            <p class="text-sm text-[#94A3B8] mt-2 leading-relaxed">
              {{ p1.description }}
            </p>
            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2 mt-4">
              {% for tag in p1.tags %}
              <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/[0.08] text-[11px] font-semibold text-[#94A3B8]">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="px-6 pb-6 pt-2 border-t border-white/[0.08] flex items-center justify-between">
          <a class="inline-flex items-center gap-2 text-xs font-medium text-[#F8FAFC] hover:text-[#8B5CF6] transition-colors duration-150" href="{{ p1.github }}" target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined text-[18px]">code</span>
            <span>GitHub</span>
          </a>
          <span class="text-xs font-mono text-[#94A3B8]">v2.4.1</span>
        </div>
      </article>

      <!-- Project 2: py-opensprinkler -->
      {% set p2 = projects.software[1] %}
      <article class="group rounded-xl bg-[#111827]/70 backdrop-blur-md border border-white/[0.08] overflow-hidden card-hover-border flex flex-col justify-between">
        <div>
          <div class="relative w-full aspect-video overflow-hidden bg-[#181c24]">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="{{ p2.title }}" src="{{ p2.image }}"/>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold font-headline text-[#F8FAFC] group-hover:text-[#8B5CF6] transition-colors duration-200">
              <a href="{{ p2.github }}" target="_blank" rel="noopener noreferrer">
                {{ p2.title }}
              </a>
            </h3>
            <p class="text-sm text-[#94A3B8] mt-2 leading-relaxed">
              {{ p2.description }}
            </p>
            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2 mt-4">
              {% for tag in p2.tags %}
              <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/[0.08] text-[11px] font-semibold text-[#94A3B8]">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="px-6 pb-6 pt-2 border-t border-white/[0.08] flex items-center justify-between">
          <a class="inline-flex items-center gap-2 text-xs font-medium text-[#F8FAFC] hover:text-[#8B5CF6] transition-colors duration-150" href="{{ p2.github }}" target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined text-[18px]">code</span>
            <span>GitHub</span>
          </a>
          <span class="text-xs font-mono text-[#94A3B8]">PyPI</span>
        </div>
      </article>

    </div>

    <!-- Project 3: Full Width Feature Card - Dimensions NFC Server -->
    {% set p3 = projects.software[2] %}
    <article class="group rounded-xl bg-[#111827]/70 backdrop-blur-md border border-white/[0.08] overflow-hidden card-hover-border">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-7 relative aspect-video lg:aspect-auto overflow-hidden bg-[#181c24] min-h-[260px]">
          <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="{{ p3.title }}" src="{{ p3.image }}"/>
          <div class="absolute top-4 left-4">
            <span class="px-3 py-1 rounded-full text-[11px] font-bold tracking-wider text-[#F8FAFC] bg-gradient-to-r from-[#aa0266] to-[#EC4899] vibe-tag-glow">
              100% VIBE CODED
            </span>
          </div>
        </div>
        <div class="lg:col-span-5 p-6 md:p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-xl md:text-2xl font-semibold font-headline text-[#F8FAFC] group-hover:text-[#8B5CF6] transition-colors duration-200">
              <a href="{{ p3.demo | default(p3.github) }}">
                {{ p3.title }}
              </a>
            </h3>
            <p class="text-sm text-[#94A3B8] mt-3 leading-relaxed">
              {{ p3.description }}
            </p>
            <!-- Tag Pills -->
            <div class="flex flex-wrap gap-2 mt-5">
              {% for tag in p3.tags %}
              <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/[0.08] text-[11px] font-semibold text-[#94A3B8]">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
          <div class="flex items-center gap-6 mt-8 pt-4 border-t border-white/[0.08]">
            <a class="inline-flex items-center gap-2 text-xs font-medium text-[#F8FAFC] hover:text-[#8B5CF6] transition-colors duration-150" href="{{ p3.github }}" target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined text-[18px]">code</span>
              <span>GitHub</span>
            </a>
            {% if p3.demo %}
            <a class="inline-flex items-center gap-1 text-xs font-medium text-[#EC4899] hover:text-[#ffb0cd] transition-colors duration-150" href="{{ p3.demo }}">
              <span>{{ p3.demoLabel | default("Read Story") }}</span>
              <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
            </a>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- SECTION 2: 3D Printing -->
  <section id="printing" class="project-section mb-16 relative scroll-mt-24" data-category="printing">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/[0.08]">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-[#4cd7f6]"></span>
        <h2 class="text-2xl md:text-3xl font-bold text-[#4cd7f6] tracking-tight font-headline">
          3D Printing
        </h2>
      </div>
      <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-[#1c2028] border border-white/[0.08] text-[#94A3B8]">
        {{ projects.printing.length }} Projects
      </span>
    </div>

    <!-- Grid for 3D Printing -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for pr in projects.printing %}
      <article class="group rounded-xl bg-[#111827]/70 backdrop-blur-md border border-white/[0.08] overflow-hidden card-hover-border flex flex-col justify-between">
        <div>
          <div class="relative w-full aspect-video overflow-hidden bg-[#181c24]">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="{{ pr.title }}" src="{{ pr.image }}"/>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold font-headline text-[#F8FAFC] group-hover:text-[#8B5CF6] transition-colors duration-200">
              <a href="{{ pr.demo | default(pr.github) }}">
                {{ pr.title }}
              </a>
            </h3>
            <p class="text-sm text-[#94A3B8] mt-2 leading-relaxed">
              {{ pr.description }}
            </p>
            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2 mt-4">
              {% for tag in pr.tags %}
              <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/[0.08] text-[11px] font-semibold text-[#94A3B8]">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="px-6 pb-6 pt-2 border-t border-white/[0.08] flex items-center justify-between">
          <a class="inline-flex items-center gap-1 text-xs font-medium text-[#4cd7f6] hover:text-[#acedff] transition-colors duration-150" href="{{ pr.demo }}">
            <span>{{ pr.demoLabel | default("Read Guide") }}</span>
            <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
          </a>
          <span class="text-xs font-mono text-[#94A3B8]">{{ pr.badge | default("STL & SCAD") }}</span>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <!-- SECTION 3: Games -->
  <section id="games" class="project-section mb-20 relative scroll-mt-24" data-category="games">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/[0.08]">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-[#A3E635]"></span>
        <h2 class="text-2xl md:text-3xl font-bold text-[#A3E635] tracking-tight font-headline">
          Games
        </h2>
      </div>
      <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-[#1c2028] border border-white/[0.08] text-[#94A3B8]">
        {{ projects.games.length }} Project
      </span>
    </div>

    <!-- Single Showcase Card - Starbase Ships -->
    {% set g1 = projects.games[0] %}
    <article class="group rounded-xl bg-[#111827]/70 backdrop-blur-md border border-white/[0.08] overflow-hidden card-hover-border">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-7 relative aspect-video lg:aspect-auto overflow-hidden bg-[#181c24] min-h-[260px]">
          <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="{{ g1.title }}" src="{{ g1.image }}"/>
        </div>
        <div class="lg:col-span-5 p-6 md:p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-xl md:text-2xl font-semibold font-headline text-[#F8FAFC] group-hover:text-[#8B5CF6] transition-colors duration-200">
              <a href="{{ g1.demo | default(g1.github) }}" target="_blank" rel="noopener noreferrer">
                {{ g1.title }}
              </a>
            </h3>
            <p class="text-sm text-[#94A3B8] mt-3 leading-relaxed">
              {{ g1.description }}
            </p>
            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2 mt-5">
              {% for tag in g1.tags %}
              <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/[0.08] text-[11px] font-semibold text-[#94A3B8]">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-4 mt-8 pt-4 border-t border-white/[0.08]">
            <div class="flex items-center gap-6">
              {% if g1.github %}
              <a class="inline-flex items-center gap-2 text-xs font-medium text-[#F8FAFC] hover:text-[#8B5CF6] transition-colors duration-150" href="{{ g1.github }}" target="_blank" rel="noopener noreferrer">
                <span class="material-symbols-outlined text-[18px]">code</span>
                <span>GitHub</span>
              </a>
              {% endif %}
              {% if g1.demo %}
              <a class="inline-flex items-center gap-1 text-xs font-medium text-[#4cd7f6] hover:text-[#acedff] transition-colors duration-150" href="{{ g1.demo }}" target="_blank" rel="noopener noreferrer">
                <span>{{ g1.demoLabel | default("Ship Catalog") }}</span>
                <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
              </a>
              {% endif %}
            </div>
            <span class="text-xs font-mono text-[#A3E635] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#A3E635] animate-pulse"></span>
              Free Blueprints Available
            </span>
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- SECTION 4: Personal Introduction / About Vincent Section -->
  <section class="my-20" id="about">
    <div class="relative rounded-2xl bg-[#111827]/90 backdrop-blur-xl border border-white/[0.08] p-8 md:p-12 overflow-hidden shadow-2xl">
      <!-- Glow Aura in Card Background -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#a078ff]/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#EC4899]/15 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <!-- Avatar Portrait with Glowing Gradient Rim -->
        <div class="relative flex-shrink-0">
          <div class="w-40 h-40 md:w-52 md:h-52 rounded-2xl p-[3px] bg-gradient-to-tr from-[#8B5CF6] via-[#EC4899] to-[#4cd7f6] shadow-xl shadow-[#a078ff]/20">
            <div class="w-full h-full rounded-2xl overflow-hidden bg-[#0B0F17]">
              <img alt="Vincent Teo avatar" class="w-full h-full object-cover" src="/assets/images/profile.jpg"/>
            </div>
          </div>
        </div>

        <!-- Intro Content -->
        <div class="flex-1 text-center md:text-left">
          <h2 class="text-3xl md:text-4xl font-bold font-headline text-[#F8FAFC] tracking-tight">
            Hi, I'm Vincent. <br/>
            <span class="bg-gradient-to-r from-[#EC4899] via-[#8B5CF6] to-[#4cd7f6] bg-clip-text text-transparent">
              Welcome to my digital space.
            </span>
          </h2>
          <p class="text-base md:text-lg text-[#94A3B8] mt-3 max-w-xl">
            Here, you'll find a showcase of my projects.
          </p>

          <!-- Social / Platform Link Buttons -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mt-8">
            <a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold text-[#F8FAFC] bg-gradient-to-r from-[#aa0266] to-[#EC4899] hover:brightness-110 transition-all duration-150 shadow-md shadow-[#EC4899]/20 active:scale-95" href="https://github.com/vinteo" target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined text-[18px]">terminal</span>
              <span>GitHub</span>
            </a>
            <a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold text-[#F8FAFC] bg-gradient-to-r from-[#D946EF] to-[#8B5CF6] hover:brightness-110 transition-all duration-150 shadow-md active:scale-95" href="https://instagram.com/vinteo" target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined text-[18px]">photo_camera</span>
              <span>Instagram</span>
            </a>
            <a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold text-[#F8FAFC] bg-[#DC2626] hover:bg-[#EF4444] transition-all duration-150 shadow-md shadow-red-500/20 active:scale-95" href="https://youtube.com/@vinteo81" target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined text-[18px]">play_circle</span>
              <span>YouTube</span>
            </a>
            <a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold text-[#F8FAFC] bg-gradient-to-r from-[#6366F1] to-[#8B5CF6] hover:brightness-110 transition-all duration-150 shadow-md active:scale-95" href="mailto:contact@vincentteo.com">
              <span class="material-symbols-outlined text-[18px]">mail</span>
              <span>Email Me</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>
