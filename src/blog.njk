---
layout: layouts/base.njk
title: Digital Journal — Vincent Teo
description: Personal writings, thoughts, and technical deep-dives.
permalink: /blog/
---

<!-- Blog Showcase Controls -->
<div class="max-w-[1240px] mx-auto px-6 md:px-8 pt-10 md:pt-16">
  <div class="border-b border-white/[0.08] pb-8 flex flex-col items-center md:items-start text-center md:text-left gap-4">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[#F8FAFC] font-headline">
      Digital Journal
    </h1>
  </div>
</div>

<!-- Blog Posts List -->
<div class="max-w-[1240px] mx-auto px-6 md:px-8 py-12 flex-grow">
  <div class="space-y-8">
    {% if collections.posts.length > 0 %}
      {% for post in collections.posts | reverse %}
      <article class="group rounded-xl bg-[#111827]/70 border border-white/[0.08] backdrop-blur-md overflow-hidden card-hover-border transition-all duration-300">
        <div class="grid grid-cols-1 md:grid-cols-12">
          {% if post.data.image %}
          <div class="md:col-span-5 lg:col-span-4 relative aspect-[16/10] md:aspect-auto overflow-hidden bg-[#181c24] min-h-[220px]">
            <a href="{{ post.url }}" class="block w-full h-full">
              <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt | default(post.data.title) }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
            </a>
          </div>
          {% endif %}
          <div class="{% if post.data.image %}md:col-span-7 lg:col-span-8{% else %}col-span-12{% endif %} p-6 md:p-8 flex flex-col justify-between">
            <div>
              <time class="text-xs font-mono font-medium text-[#94A3B8] tracking-wider uppercase block mb-3">
                {{ post.date | postDate }}
              </time>
              
              <h2 class="text-xl md:text-2xl font-bold font-headline text-[#F8FAFC] group-hover:text-[#8B5CF6] transition-colors duration-200">
                <a href="{{ post.url }}">
                  {{ post.data.title }}
                </a>
              </h2>
              
              <p class="mt-3 text-sm text-[#94A3B8] leading-relaxed">
                {{ post.data.description }}
              </p>
              
              <!-- Tags -->
              <div class="mt-5 flex flex-wrap gap-2">
                {% for tag in post.data.tags %}
                  {% if tag != "posts" %}
                  <span class="inline-flex items-center rounded-full bg-white/5 border border-white/[0.08] px-2.5 py-1 text-[11px] font-semibold text-[#94A3B8]">
                    {{ tag }}
                  </span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between">
              <a href="{{ post.url }}" class="inline-flex items-center gap-1.5 text-xs font-medium text-[#EC4899] hover:text-[#ffb0cd] transition-colors duration-150">
                <span>Read Article</span>
                <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
              </a>
            </div>
          </div>
        </div>
      </article>
      {% endfor %}
    {% else %}
      <div class="text-center py-20 bg-[#111827]/40 rounded-xl border border-white/[0.08] p-8">
        <p class="text-[#94A3B8]">No posts written yet. Check back soon!</p>
      </div>
    {% endif %}
  </div>
</div>
